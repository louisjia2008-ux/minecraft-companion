{
  "name": "deskpet-electron",
  "productName": "DeskPet Electron",
  "version": "0.1.0",
  "description": "A secure, cross-platform Live2D desktop companion that runs beside the native DeskPet app.",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": ".webpack/main",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.1",
    "gh-pages": "6.3.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6"
  },
  "scripts": {
    "start": "npm run build:migration && electron-forge start",
    "build:migration": "node scripts/build-migration.mjs",
    "build": "npm run package",
    "package": "npm run build:migration && npm run prepare:minecraft && electron-forge package",
    "make": "npm run build:migration && npm run prepare:minecraft && electron-forge make",
    "lint": "eslint . --max-warnings=0 && npm run lint:minecraft-engine",
    "lint:minecraft-engine": "eslint --config eslint.minecraft.config.mjs \"minecraft-runtime/vendor/server/**/*.js\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "audit:package": "node scripts/audit-package.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:security && npm run test:minecraft && npm run test:minecraft:acceptance && npm run build && npm run audit:package && npm run smoke:minecraft-package",
    "postinstall": "npm ci --prefix minecraft-runtime --ignore-scripts",
    "prepare:minecraft": "node scripts/prepare-minecraft.mjs",
    "test:minecraft": "npm test --prefix minecraft-runtime",
    "setup:minecraft:local": "node scripts/setup-minecraft-local.mjs",
    "test:minecraft:setup": "node --test scripts/setup-minecraft-local.test.mjs",
    "test:minecraft:live": "node minecraft-runtime/test-support/real-diamond-server.cjs",
    "smoke:minecraft-package": "node scripts/smoke-minecraft-package.mjs",
    "test:minecraft:natural": "node minecraft-runtime/test-support/real-natural-diamond-server.cjs",
    "test:minecraft:lava": "node minecraft-runtime/test-support/real-bucket-lava-server.cjs",
    "test:minecraft:house": "node minecraft-runtime/test-support/real-furnished-house-server.cjs",
    "test:minecraft:acceptance": "node --test minecraft-runtime/test-support/*.test.cjs"
  },
  "dependencies": {
    "@pixi/filter-alpha": "^5.2.1",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "^25.5.2",
    "jszip": "^3.10.1",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^16.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^5.0.2",
    "css-loader": "^7.1.2",
    "electron": "44.4.5",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "vitest-axe": "^0.1.0"
  }
}
