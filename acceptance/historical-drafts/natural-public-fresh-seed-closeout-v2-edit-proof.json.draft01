      "before": "  const result = load(path.join(run, 'result.json'));",
      "after": "  const result = load(path.join(run, 'result.json'));\n  const seedProof = require('../acceptance/fresh-seed-allocation-v1.cjs').inspectSeedAllocation(run);\n  const seedAllocation = seedProof.allocation;\n  report.seedAllocation = seedProof;\n  check('freshSeedAllocationIdentity', result.runnerRevision === 6 && result.seedPolicyRevision === 1 && result.seed === seedAllocation.seed && result.runName === seedAllocation.runName && result.version === seedAllocation.version && seedAllocation.preflightOnly === false, seedProof);\n  check('allocatedRunnerSource', hash(runner) === seedAllocation.runner.sha256 && result.sourceHashes?.started?.['private/natural-public-building-acceptance.cjs'] === seedAllocation.runner.sha256, seedAllocation.runner);\n  const allocatorPath = path.join(path.dirname(runner), 'fresh-seed-allocation-v1.cjs');\n  check('allocatedSeedHelperSource', hash(allocatorPath) === seedAllocation.allocator.sha256 && result.sourceHashes?.started?.['private/fresh-seed-allocation-v1.cjs'] === seedAllocation.allocator.sha256, seedAllocation.allocator);\n  check('allocatedRuntimeSource', seedAllocation.runtime.status === 'RECORDED' && Object.entries(seedAllocation.runtime.files).every(([name, expected]) => result.sourceHashes?.started?.[name] === expected), seedAllocation.runtime);\n  const propertySeed = fs.readFileSync(path.join(run, 'server.properties'), 'utf8').match(/^level-seed=(.*)$/m)?.[1].trim();\n  check('allocatedServerPropertiesSeed', propertySeed === seedAllocation.seed, { propertySeed, allocatedSeed: seedAllocation.seed });"
    },
    {
      "before": "? runner : path.join(path.resolve(values['--private-root'] || '/private/tmp'), path.basename(name))",
